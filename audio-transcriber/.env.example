# WhisperX Configuration
# Copy to .env and fill in your values

# Hugging Face token for pyannote diarization (required for speaker identification)
# Get one at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Device: cuda, mps, cpu, or openvino
DEVICE=cuda

# Compute type: float16 (CUDA), float32 (MPS), int8 (CPU)
COMPUTE_TYPE=float16

# Whisper model size: base, medium, large-v2, large-v3-turbo
MODEL=large-v2

# Number of speakers (set to 0 or empty to auto-detect)
MIN_SPEAKERS=2
MAX_SPEAKERS=2

# Output directory
OUTPUT_DIR=./output

# Output formats: comma-separated (txt, srt, vtt, tsv, json) or 'all'
OUTPUT_FORMAT=all

# Batch size (reduce if OOM: 16, 8, 4)
BATCH_SIZE=16

# Beam size for transcription
BEAM_SIZE=5
